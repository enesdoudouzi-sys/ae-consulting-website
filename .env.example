# Kopieren nach .env (wird nicht committet) bzw. in Render unter "Environment" eintragen.
NODE_ENV=development
PORT=3000
# Erlaubte Website-Herkunft(en), kommagetrennt
SITE_ORIGIN=http://localhost:8000
# Neon-Postgres Verbindungs-URL
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Resend (E-Mail-Versand)
RESEND_API_KEY=re_xxx
# Absender – für Mails an Kunden muss die Domain bei Resend verifiziert sein
RESEND_FROM_EMAIL=AE Consulting <kontakt@ihre-domain.de>
# Empfänger der Benachrichtigung über neue Anfragen
CONTACT_TO_EMAIL=enesdoudouzi@gmail.com
# Eingangsbestätigung an den Kunden senden (nur mit verifizierter Domain): true/false
SEND_CONFIRMATION=false
# Anfragen nach so vielen Tagen automatisch löschen (7–730, Standard 180)
RETENTION_DAYS=180
